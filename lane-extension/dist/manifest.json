{
  "manifest_version": 3,
  "name": "Lane",
  "version": "1.0.0",
  "description": "One-click job application tracker that works on any career page",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ],
  "options_page": "src/dashboard/index.html",
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Lane"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/detector.ts-loader-D931rDe2.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "assets/storage-BTG_-nOz.js",
        "assets/detector.ts-CL9CyUom.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
